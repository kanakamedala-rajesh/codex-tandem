{
  "schema": 1,
  "provenance": "Hand-authored synthetic metadata; donor inspection plus approved SRS. No real conversations, accounts, credentials or telemetry.",
  "donorCommit": "516a1d6306559d8a607de84c4d76529160349ac8",
  "contract": {
    "recordExpansion": "Each record receives timestamp 2026-10-02T00:00:00.000Z unless overridden. Each source starts with independent empty parser state. Replay orders preserve order within each source. Named records expand literally, not via product code.",
    "vectors": "Expected vectors are [input,cached,write,output,reasoning]. Cached and write partition input; reasoning is a subset of output. Decimal strings express exact expected integer results, not a proposed ingestion wire format.",
    "outcomes": "These are future accounting seam oracles, not evidence of a passing accounting implementation. Diagnostic labels describe semantics and do not freeze CLI wording or a database schema.",
    "sourceOwnership": "A source's first session_meta owns the physical source. Repeated copies of a response do not create new work. Native/legacy reconciliation requires evidence that both describe the same work."
  },
