{
  "name": "codex-tandem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codex-tandem": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc && node scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "setup:hooks": "git config --local core.hooksPath .githooks",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:discovery": "node scripts/verify-discovery-package.mjs",
    "verify:capture": "node scripts/verify-capture-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "validate": "npm run check:repo && npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "verify:installed": "npm run verify:package && npm run verify:discovery && npm run verify:capture"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.0",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.0"
  }
}
